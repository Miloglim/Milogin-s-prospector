{
  "name": "prospecting-email",
  "version": "0.5.6-alpha.1",
  "description": "Milogin's Outreacher — 货代行业客户开发工具",
  "main": "./dist/main/index.js",
  "scripts": {
    "dev": "set NODE_OPTIONS= && chcp 65001 >nul && electron-vite dev",
    "build": "electron-vite build",
    "pack": "electron-vite build && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:agent": "set AGENT_EVAL=live&& vitest run tests/eval",
    "check": "npx tsx scripts/check.ts",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.0",
    "@ant-design/x": "^1.6.1",
    "@openai/agents": "^0.17.0",
    "@tanstack/react-query": "^5.60.0",
    "@tanstack/react-router": "^1.170.0",
    "antd": "^5.22.0",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "drizzle-orm": "^0.36.0",
    "electron-updater": "^6.0.0",
    "imapflow": "^1.6.5",
    "lucide-react": "^0.460.0",
    "mailparser": "^3.9.14",
    "nodemailer": "^9.0.3",
    "openai": "^7.8.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "undici": "^6.28.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/dompurify": "^3.0.5",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.28.0",
    "electron": "^37.10.3",
    "electron-builder": "^25.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.0",
    "rcedit": "^5.0.2",
    "sql.js": "^1.14.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "com.miloglim.prospecting-email",
    "productName": "Milogin's Prospector.",
    "directories": {
      "output": "../dist-release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "${name}-setup-${version}.${ext}",
      "sign": null
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "Miloglim",
      "repo": "Milogin-s-prospector"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "asar": true,
    "afterPack": "./scripts/embed-icon.js",
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ]
  }
}
