# 由公司部署人员在服务器环境中手工配置，不要提交真实值。
# 一体化部署脚本输入（只存在于当前受控进程）：
# MILOGIN_DATABASE_ADMIN_DSN=postgresql://<existing-admin>@127.0.0.1:<port>/postgres
# MILOGIN_DEFAULT_ADMIN_PASSWORD=<initial product superadmin password>
# 运行时由 %ProgramData%/MiloginCenter/postgres.json 自动生成应用数据库 DSN；
# 下列 PROSPECTOR_* 供手工启动或故障恢复使用。
PROSPECTOR_CENTER_MODE=production
PROSPECTOR_CENTER_PG_DSN=postgresql://milogin_app:CHANGE_ME@127.0.0.1:55846/milogin_center
PROSPECTOR_CENTER_PUBLIC_ORIGIN=https://crm.example.internal
PROSPECTOR_NAVIGATOR_URL=http://127.0.0.1:8795
PROSPECTOR_NAVIGATOR_ENTRY_URL=https://rates.example.internal
# Navigator 进程另设 NAVIGATOR_AGENT_API_TOKEN（至少 32 字符），不要写在本文件。
